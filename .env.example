# .env.example — OJ Content Engine
# Copy to .env.local (Vercel) or .env (Worker) and fill in real values.
# See CLAUDE.md "Environment Variables" section for details.

# =============================================================================
# LLM Providers (Worker layer — scoring + generation)
# =============================================================================
GROQ_API_KEY=gsk_...                  # Groq API key for fast LLM scoring + short-form generation
ANTHROPIC_API_KEY=sk-ant-...          # Anthropic API key for Substack generation + voice-drift critique

# Per-platform model overrides (optional — defaults: Substack=Anthropic, others=Groq)
# Format: provider/model
# GENERATION_MODEL_SUBSTACK=anthropic/claude-sonnet-4-6
# GENERATION_MODEL_SUBSTACK_CRITIQUE=anthropic/claude-sonnet-4-6
# GENERATION_MODEL_TWITTER=groq/llama-3.3-70b-versatile
# GENERATION_MODEL_LINKEDIN=groq/llama-3.3-70b-versatile
# GENERATION_MODEL_INSTAGRAM=groq/llama-3.3-70b-versatile

# =============================================================================
# Postgres (Shared — both Vercel and Worker connect to the same instance)
# =============================================================================
DATABASE_URL=postgresql://...          # Neon Postgres full connection string

# =============================================================================
# Redis (Shared — Upstash serverless Redis)
# =============================================================================
UPSTASH_REDIS_REST_URL=https://...    # Upstash REST URL (used by Vercel layer)
UPSTASH_REDIS_REST_TOKEN=...          # Upstash REST token (used by Vercel layer)
ARQ_REDIS_URL=redis://...             # Standard Redis URL (used by ARQ on Worker layer)

# =============================================================================
# Notion (Worker writes, Vercel reads)
# =============================================================================
NOTION_API_KEY=secret_...             # Notion integration token
NOTION_DB_ID=...                      # Second Brain database ID

# =============================================================================
# Worker ↔ Vercel Authentication
# =============================================================================
WORKER_SECRET=...                     # Shared secret for Vercel → Worker API calls

# =============================================================================
# Discovery Sources (Worker layer)
# =============================================================================
RSS_FEED_URLS=...                     # Comma-separated list of RSS feed URLs
TWITTER_BEARER_TOKEN=...              # Twitter API v2 bearer token (Basic tier)
REDDIT_CLIENT_ID=...                  # Reddit app client ID
REDDIT_CLIENT_SECRET=...              # Reddit app client secret

# =============================================================================
# Approval UI (Vercel layer)
# =============================================================================
DASHBOARD_TOKEN=                      # Secret token for dashboard auth
WORKER_URL=http://localhost:8001      # Worker FastAPI base URL
